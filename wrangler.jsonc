{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "couple-calendar",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    // Only the API and audio run through the Worker; every page is served as a static file.
    "run_worker_first": ["/api/*", "/audio/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "couple-calendar",
      "database_id": "6611248d-6744-48cd-92cd-6eb359f02b5d",
      "migrations_dir": "migrations"
    }
  ]
}
