---
import "../styles/global.css";
import { getCollection } from "astro:content";
import { site, menu, daySlug } from "../data/site";

const days = (await getCollection("days")).map((d) => d.data).sort((a, b) => a.day - b.day);
const [home, ...otherLinks] = menu;
const current = Astro.url.pathname.replace(/\.html$/, "");

interface Props {
  title?: string;
  description?: string;
}

const { title, description = "Couples Calendar – Deeper Connection." } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <!-- Content is only for calendar owners; keep it out of search engines. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#563a7c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=Figtree:wght@300;400;600;700&family=Playfair+Display:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu">
        <span></span><span></span><span></span>
      </button>
      <a href="/" class="logo">{site.name}</a>
    </header>

    <nav id="menu" class="menu" hidden>
      <a class="menu-link" href={home.href} aria-current={current === home.href ? "page" : undefined}>{home.label}</a>
      <p class="menu-heading">All days</p>
      <ul class="menu-days">
        {
          days.map((d) => {
            const href = `/${daySlug(d)}`;
            return (
              <li>
                <a href={href} aria-current={current === href ? "page" : undefined}>
                  <span class="menu-day-num">{d.day}</span>
                  <span class="menu-day-title">{d.title}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
      {otherLinks.map((m) => <a class="menu-link" href={m.href} aria-current={current === m.href ? "page" : undefined}>{m.label}</a>)}
    </nav>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>{site.copyright}</p>
      <p>{site.legal}</p>
    </footer>

    <a href="#" class="to-top" aria-label="Back to top">
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M5 15l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </a>
  </body>
</html>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".menu-btn")!;
  const menu = document.getElementById("menu")!;
  btn.addEventListener("click", () => {
    const open = menu.hidden;
    menu.hidden = !open;
    btn.setAttribute("aria-expanded", String(open));
    btn.classList.toggle("is-open", open);
  });

  const toTop = document.querySelector<HTMLElement>(".to-top")!;
  const onScroll = () => toTop.classList.toggle("is-visible", scrollY > 600);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: 48px 1fr 48px;
    align-items: center;
    padding: calc(14px + env(safe-area-inset-top)) 16px 14px;
    background: linear-gradient(180deg, rgb(86 58 124 / 0.92), rgb(63 42 98 / 0.92));
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid rgb(248 225 191 / 0.1);
  }

  .logo {
    grid-column: 2;
    justify-self: center;
    font-family: var(--script);
    font-size: clamp(2rem, 9vw, 2.6rem);
    line-height: 1;
    color: var(--cream);
    text-decoration: none;
  }

  .menu-btn {
    display: grid;
    gap: 6px;
    width: 44px;
    height: 44px;
    padding: 10px 6px;
    border: 0;
    background: none;
  }

  .menu-btn span {
    display: block;
    height: 3px;
    border-radius: 3px;
    background: var(--gold);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .menu-btn.is-open span:nth-child(1) {
    transform: translateY(9px) rotate(45deg);
  }

  .menu-btn.is-open span:nth-child(2) {
    opacity: 0;
  }

  .menu-btn.is-open span:nth-child(3) {
    transform: translateY(-9px) rotate(-45deg);
  }

  .menu {
    position: fixed;
    inset: 72px 12px auto;
    z-index: 19;
    max-width: 560px;
    max-height: calc(100dvh - 92px);
    margin: 0 auto;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 12px;
    border-radius: 24px;
    background: #2d144b;
    border: 1px solid rgb(248 225 191 / 0.14);
    box-shadow: 0 24px 50px -20px rgb(0 0 0 / 0.6);
  }

  .menu a {
    color: var(--cream);
    text-decoration: none;
  }

  .menu a:hover,
  .menu a[aria-current="page"] {
    background: rgb(248 225 191 / 0.1);
  }

  .menu-link {
    display: block;
    padding: 12px 16px;
    border-radius: 16px;
    font-family: var(--serif);
    font-size: 1.3rem;
  }

  .menu-heading {
    margin: 10px 16px 6px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .menu-days {
    list-style: none;
    margin: 0 0 8px;
    padding: 0;
  }

  .menu-days a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 12px;
    border-radius: 14px;
  }

  .menu-day-num {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgb(245 179 1 / 0.6);
    color: var(--gold);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .menu a[aria-current="page"] .menu-day-num {
    background: var(--gold);
    color: #2a1640;
  }

  .menu-day-title {
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .site-footer {
    padding: 36px 24px calc(40px + env(safe-area-inset-bottom));
    background: var(--footer);
    text-align: center;
    font-size: 0.95rem;
    color: rgb(248 225 191 / 0.75);
  }

  .site-footer p {
    max-width: 520px;
    margin: 0 auto 6px;
  }

  .to-top {
    position: fixed;
    right: 16px;
    bottom: calc(20px + env(safe-area-inset-bottom));
    z-index: 10;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    color: var(--header-dark);
    box-shadow: 0 10px 24px -8px rgb(0 0 0 / 0.5);
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .to-top:global(.is-visible) {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }
</style>
