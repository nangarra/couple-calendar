---
import { existsSync } from "node:fs";
import { site } from "../data/site";

interface Props {
  src: string;
  title: string;
  duration?: string;
}

const { src, title, duration = "--:--" } = Astro.props;
// Audio files go in public/audio. Until a file is added the player shows "coming soon".
const available = existsSync(`public${src}`);
---

<div class:list={["player", { "is-unavailable": !available }]} data-player>
  <div class="cover">
    <img src="/images/faces-lineart.png" alt="" width="146" height="158" />
  </div>
  <div class="body">
    <p class="meta">
      <span class="track">{title}</span>
      <span class="artist">{available ? site.name : "Audio coming soon"}</span>
    </p>
    <div class="controls">
      <button class="play" type="button" aria-label={`Play ${title}`} disabled={!available}>
        <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"></path></svg>
        <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"></path></svg>
      </button>
      <input class="seek" type="range" min="0" max="1000" value="0" step="1" aria-label="Seek" disabled={!available} />
      <span class="time">-{duration}</span>
    </div>
  </div>
  {available && <audio preload="metadata" src={src}></audio>}
</div>

<script>
  const fmt = (s: number) => {
    if (!isFinite(s)) return "--:--";
    const m = Math.floor(s / 60);
    return `${String(m).padStart(2, "0")}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
  };

  document.querySelectorAll<HTMLElement>("[data-player]").forEach((el) => {
    const audio = el.querySelector("audio");
    if (!audio) return;
    const play = el.querySelector<HTMLButtonElement>(".play")!;
    const seek = el.querySelector<HTMLInputElement>(".seek")!;
    const time = el.querySelector<HTMLElement>(".time")!;
    let dragging = false;

    const render = () => {
      const d = audio.duration;
      if (!dragging && d) seek.value = String((audio.currentTime / d) * 1000);
      seek.style.setProperty("--p", `${Number(seek.value) / 10}%`);
      if (d) time.textContent = `-${fmt(d - audio.currentTime)}`;
    };

    play.addEventListener("click", () => {
      // Only one track plays at a time.
      document.querySelectorAll("audio").forEach((a) => a !== audio && a.pause());
      audio.paused ? audio.play() : audio.pause();
    });
    audio.addEventListener("play", () => el.classList.add("is-playing"));
    audio.addEventListener("pause", () => el.classList.remove("is-playing"));
    audio.addEventListener("timeupdate", render);
    audio.addEventListener("loadedmetadata", render);
    seek.addEventListener("input", () => {
      dragging = true;
      seek.style.setProperty("--p", `${Number(seek.value) / 10}%`);
    });
    seek.addEventListener("change", () => {
      dragging = false;
      if (audio.duration) audio.currentTime = (Number(seek.value) / 1000) * audio.duration;
    });
  });
</script>

<style>
  .player {
    display: flex;
    align-items: stretch;
    margin: 28px 0;
    overflow: hidden;
    border-radius: 24px;
    background: linear-gradient(135deg, #2c1745, #1f0f33);
    box-shadow:
      0 0 0 2px var(--gold),
      0 18px 40px -16px rgb(245 179 1 / 0.35);
  }

  .cover {
    flex: none;
    display: grid;
    place-items: center;
    width: 30%;
    max-width: 128px;
    background: radial-gradient(circle at 30% 30%, #fffaf2, #f6ead8);
  }

  .cover img {
    width: 78%;
    height: auto;
    filter: brightness(0.82) saturate(1.2);
  }

  .body {
    flex: 1;
    min-width: 0;
    padding: 16px 18px 16px 20px;
  }

  .meta {
    display: flex;
    flex-direction: column;
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .track {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-family: var(--serif);
    font-size: 1.15rem;
    color: var(--white);
  }

  .artist {
    font-size: 0.9rem;
    color: rgb(248 225 191 / 0.7);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .play {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--gold);
    color: #2a1640;
    transition: transform 0.15s ease;
  }

  .play:hover:not(:disabled) {
    transform: scale(1.06);
  }

  .play svg {
    width: 24px;
    height: 24px;
  }

  .i-pause,
  .is-playing .i-play {
    display: none;
  }

  .is-playing .i-pause {
    display: block;
  }

  .seek {
    --p: 0%;
    flex: 1;
    min-width: 0;
    height: 6px;
    margin: 0;
    appearance: none;
    border-radius: 6px;
    background: linear-gradient(90deg, var(--cream) var(--p), rgb(255 255 255 / 0.18) var(--p));
    cursor: pointer;
  }

  .seek::-webkit-slider-thumb {
    appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--white);
  }

  .seek::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border: 0;
    border-radius: 50%;
    background: var(--white);
  }

  .time {
    flex: none;
    font-variant-numeric: tabular-nums;
    font-size: 0.95rem;
    color: var(--cream);
  }

  .is-unavailable .play,
  .is-unavailable .seek {
    opacity: 0.4;
    cursor: default;
  }
</style>
