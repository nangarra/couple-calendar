---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
// open.spotify.com/playlist/<id> → open.spotify.com/embed/playlist/<id>
const embed = url ? url.replace("open.spotify.com/", "open.spotify.com/embed/").split("?")[0] : "";
---

{
  embed ? (
    <iframe
      class="spotify"
      src={`${embed}?utm_source=generator&theme=0`}
      title={title}
      width="100%"
      height="352"
      loading="lazy"
      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
    />
  ) : (
    <div class="spotify spotify-pending">
      <svg viewBox="0 0 24 24" width="36" height="36" aria-hidden="true">
        <circle cx="12" cy="12" r="11" fill="#1ed760" />
        <path d="M6.5 9.3c3.8-1.1 8-.8 11.2 1M7.2 12.4c3.1-.9 6.4-.6 9.1.9M7.8 15.3c2.5-.7 5-.5 7.1.7" stroke="#121212" stroke-width="1.6" fill="none" stroke-linecap="round" />
      </svg>
      <div>
        <strong>{title}</strong>
        <span>Playlist coming soon</span>
      </div>
    </div>
  )
}

<style>
  .spotify {
    display: block;
    margin: 28px 0 0;
    border: 0;
    border-radius: 20px;
  }

  .spotify-pending {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    background: #1d1b2a;
  }

  .spotify-pending div {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }

  .spotify-pending strong {
    font-weight: 600;
    color: var(--white);
  }

  .spotify-pending span {
    font-size: 0.9rem;
    color: rgb(255 255 255 / 0.6);
  }
</style>
