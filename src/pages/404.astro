---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { daySlug } from "../data/site";

const days = (await getCollection("days")).map((d) => d.data).sort((a, b) => a.day - b.day);
---

<Base title="Page not found">
  <section class="panel lost">
    <span class="kicker">Oops</span>
    <h1 class="title">This page could not be found</h1>
    <p>Choose your day below, or scan the QR-code inside the hatch again.</p>

    <ul class="days">
      {
        days.map((d) => (
          <li>
            <a href={`/${daySlug(d)}`}>
              <span class="num">{d.day}</span>
              <span class="name">{d.title}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <a class="btn" href="/">Go to start</a>
  </section>
</Base>

<style>
  .lost {
    text-align: center;
  }

  .lost p {
    margin: 0 0 24px;
  }

  .days {
    list-style: none;
    display: grid;
    gap: 10px;
    margin: 0 0 32px;
    padding: 0;
    text-align: left;
  }

  .days a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-radius: 18px;
    background: rgb(248 225 191 / 0.07);
    border: 1px solid rgb(248 225 191 / 0.14);
    color: var(--cream);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .days a:hover {
    background: rgb(248 225 191 / 0.14);
  }

  .num {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--gold);
    color: #2a1640;
    font-weight: 700;
  }

  .name {
    font-size: 1.1rem;
    line-height: 1.3;
  }
</style>
