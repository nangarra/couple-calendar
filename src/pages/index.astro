---
import Base from "../layouts/Base.astro";
---

<Base>
  <section class="panel home">
    <img class="hero-art" src="/images/couple-lineart.png" alt="Line drawing of a couple embracing" width="281" height="423" />
    <span class="kicker">Couples Calendar</span>
    <h1 class="title">Deeper Connection</h1>
    <div class="prose">
      <p>Welcome to the Couples Calendar experience. This content is only available through QR-codes from the physical Calendar.</p>
      <p><strong class="hl">If you have a calendar,</strong> you can access this content using the QR-code inside each hatch.</p>
    </div>
    <video class="welcome-video" src="/video/welcome.mp4" poster="/video/welcome-poster.jpg" width="720" height="1280" controls playsinline preload="metadata"></video>
  </section>
</Base>

<style>
  .hero-art {
    display: block;
    width: 58%;
    max-width: 240px;
    height: auto;
    margin: 0 auto 18px;
    filter: drop-shadow(0 6px 24px rgb(245 179 1 / 0.15));
  }

  .home .prose {
    font-size: 1.25rem;
  }

  .welcome-video {
    display: block;
    width: 100%;
    max-width: 360px;
    height: auto;
    margin: 8px auto 0;
    border-radius: 24px;
    background: #1f0f33;
    box-shadow:
      0 0 0 2px rgb(248 225 191 / 0.2),
      0 24px 50px -20px rgb(0 0 0 / 0.6);
  }

  .hl {
    font-weight: 700;
    color: var(--cream);
  }
</style>
